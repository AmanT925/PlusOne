# Copy values into the repo-root `.env` (gitignored).

PLUSONE_ROOM_ID=demo
PLUSONE_DB=server/plusone.db
# PLUSONE_HANDLES=sam:+15551111111,priya:+15552222222

# Either name works; the server treats LINQ as LINQ_API_KEY.
# LINQ=
# LINQ_API_KEY=
# Plus One's Linq line (E.164)
LINQ_FROM=+19492783794
# LINQ_WEBHOOK_SECRET=whsec_...
# LINQ_SKIP_VERIFY=1

# SpaceXAI / Part B — Grok Voice + Imagine (keys stay on the server)
# XAI_API_KEY=
# XAI_TTS_VOICE=eve
# PLUSONE_VOICE=1
# PLUSONE_IMAGINE=1
# Budget (seconds) before sending text-only whisper and finishing audio in background:
# PLUSONE_TTS_BUDGET_SEC=2.8
# Public HTTPS origin (ngrok) so Expo / Korvo can fetch /media/... off-device:
# PLUSONE_PUBLIC_BASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.app

# Meta Muse (STT for Korvo hold-to-talk; Spark is Part A)
# MUSE_API_KEY=
# MUSE_TRANSCRIBE_KEY=
